<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-FileCopyrightText: 2026 Iya CyberSecurity Solutions, LLC
  SPDX-License-Identifier: MIT

  Applied by Jetty AFTER the IdP war's own WEB-INF/web.xml (#425). That file
  marks the servlet session cookie (JSESSIONID) Secure, which is right for an
  IdP behind TLS and wrong for this side-car, which the stack reaches over
  plain HTTP: a browser drops a Secure cookie set over http, so the login
  flow's next step finds no session and Shibboleth answers "Web Login Service
  - Stale Request". idp.cookie.secure=false (idp-merge.properties) covers the
  IdP's own cookies and not this one. A node client with its own cookie jar
  never notices, which is why only a browser job found it.
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
  <session-config>
    <cookie-config>
      <http-only>true</http-only>
      <secure>false</secure>
    </cookie-config>
  </session-config>
</web-app>
