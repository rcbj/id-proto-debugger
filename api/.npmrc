# Do not install devDependencies, and read this before removing it.
#
# This service has none of its own, so on the face of it the setting does
# nothing. What it is for is the `"ldapjs": "file:../node-ldapjs"` dependency —
# the git submodule at the repository root. npm installs the devDependencies of
# a local-path dependency along with its runtime ones, and ldapjs's are tap,
# eslint and their trees: roughly 200 extra packages and a dozen advisories,
# none of which this service loads or ships.
#
# Without this line a bare `npm install` here produces an `npm audit` report
# full of findings against a test runner that is not part of the product, which
# is the kind of noise that gets a real finding ignored. api/Dockerfile passes
# --omit=dev as well, so losing this file does not change the image; it changes
# what a developer sees on their own checkout.
omit=dev
