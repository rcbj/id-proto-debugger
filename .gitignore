api/node_modules
client/node_modules
node_modules
.idea
tests/report
tests/node_modules
# Code coverage output
coverage/

# Downloaded IdP metadata (remote-run-tests.sh / common.sh download_saml_metadata)
tests/saml-idp-metadata.xml
saml-idp-metadata.xml

# The SAML SP key pair is generated per test run (common/common.sh
# generateSpKeyPair) and lives only in the run's environment. These names are
# listed so a stray copy can never be committed.
tests/fixtures/*
# ...except the abstract data model's recorded api answers, which ARE the
# baseline tests/api_model_wire.js replays (models/CLAUDE.md). A directory
# pattern above would hide them; `/*` lets this one directory back in.
!tests/fixtures/api_model/
# ...and the W3C vc-di-bbs specification's own test vectors, which
# tests/bbs2023_cryptosuite.js asserts against (their source is inside).
!tests/fixtures/vc_di_bbs_vectors.json
# ...and the vc-di-ecdsa ecdsa-sd-2023 ones, for tests/ecdsa_sd_2023_engine.js.
!tests/fixtures/vc_di_ecdsa_sd_vectors.json
!tests/fixtures/jwp_jpa15_vectors.json
!tests/fixtures/sd_cwt_09_vectors.json
sp-key.pem
sp-cert.pem

# walt.id's configuration rendered per run: it contains that run's issuer key.
waltid/generated-config/
waltid/generated-verifier-config/

# Build-time version stamps (client/version.js --stamp) and the copies of the
# shared version module the images make. They belong to one build and are written
# INSIDE the image by api/Dockerfile and client/Dockerfile — a committed one would
# make every later build report a version it is not.
api/version.json
api/version.js
client/public/version.json

*.swp

# The browser extension is BUILT (extension/build.js stamps the version and
# bakes the CI auto-arm origin), so the output is generated per run and not
# committed. buildBrowserExtension() in common/common.sh writes it before
# compose builds, and tests/Dockerfile COPYs extension/dist/ci.
extension/dist/

# Terraform working directories. `terraform init` downloads provider plugins
# into these — about 700MB for the aws provider alone — and they are rebuilt by
# the next init. State is remote (S3, see infra/bootstrap-state.sh) and must
# never be on disk; the *.tfstate patterns are here so a stray local backend
# cannot be committed by accident.
infra/**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# The per-run TLS pair the api and the client serve (./generate-tls-cert.sh).
# Regenerated on demand and never committed — see common/generate_tls_cert.js.
generated-tls/

# The local certificate authority that pair is issued from: a Root CA and an
# Issuing CA, from client/src/x509.js's own profiles. Kept OUT of
# generated-tls/ because compose bind-mounts that into both containers and the
# root's private key — the one a developer imports into their own browser and
# OS trust store — has no business inside one. It PERSISTS between runs on
# purpose, which is what makes trusting the root a one-time act; that also
# makes it the one key here worth keeping off a git remote.
generated-tls-ca/
