api/node_modules
client/node_modules
node_modules
.idea
tests/report
tests/node_modules
# Code coverage output
coverage/

# Downloaded IdP metadata (remote-run-tests.sh / common.sh download_saml_metadata)
tests/saml-idp-metadata.xml
saml-idp-metadata.xml

# The SAML SP key pair is generated per test run (common/common.sh
# generateSpKeyPair) and lives only in the run's environment. These names are
# listed so a stray copy can never be committed.
tests/fixtures/
sp-key.pem
sp-cert.pem

# walt.id's configuration rendered per run: it contains that run's issuer key.
waltid/generated-config/
waltid/generated-verifier-config/

# Build-time version stamps (client/version.js --stamp) and the copies of the
# shared version module the images make. They belong to one build and are written
# INSIDE the image by api/Dockerfile and client/Dockerfile — a committed one would
# make every later build report a version it is not.
api/version.json
api/version.js
client/public/version.json

*.swp

# The browser extension is BUILT (extension/build.js stamps the version and
# bakes the CI auto-arm origin), so the output is generated per run and not
# committed. buildBrowserExtension() in common/common.sh writes it before
# compose builds, and tests/Dockerfile COPYs extension/dist/ci.
extension/dist/
