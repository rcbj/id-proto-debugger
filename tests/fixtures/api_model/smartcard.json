      "method": "POST",
      "path": "/smartcard/otp/challenge",
      "body": {
        "slot": 38,
        "challenge": "0102030405"
      },
      "changed": "slot is a string or null in the model: it is hex text. Until then the number 38 was stringified and read as hex 0x38, which only works because the digits happen to coincide.",
      "before": {
        "status": 502,
        "body": {
          "error": "HID needs the node-hid module, which this api does not have. Run the api natively (node api/native.js --smartcard), where npm installs it."
