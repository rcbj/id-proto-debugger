      "expect": {
        "status": 302,
        "body": {
          "(not JSON)": ""
        },
        "location": "https://client:3000/wsfed_response.html?signout=wsignin1.0"
      }
    },
    {
      "name": "landing (POST): the same landing accepts a JSON body",
      "method": "POST",
      "path": "/wsfed",
      "body": {
        "wa": "wsignin1.0",
        "wresult": "<t:RequestSecurityTokenResponse xmlns:t=\"http://schemas.xmlsoap.org/ws/2005/02/trust\"><t:TokenType>urn:oasis:names:tc:SAML:2.0:assertion</t:TokenType></t:RequestSecurityTokenResponse>"
      },
      "volatile": [
        "location"
      ],
      "expect": {
