    {
      "name": "response: an id nothing was stashed under is not found",
      "method": "GET",
      "path": "/wsfedresponse?id=0123456789abcdef",
      "expect": {
        "status": 404,
        "body": {
          "error": "not found or expired"
        }
      }
    },
    {
      "name": "response: a repeated id is the wrong type",
      "method": "GET",
      "path": "/wsfedresponse?id=a&id=b",
      "changed": "A repeated ?id= is a list, not the one string the endpoint takes; it used to be joined with a comma and looked up as an id that cannot exist. The model refuses it.",
      "before": {
        "status": 404,
        "body": {
          "error": "not found or expired"
        }
      },
      "expect": {
        "status": 400,
        "body": {
          "error": "Refusing the request: query parameter `id` must be a string. GET /api-docs describes what wsfedResponse takes.",
          "code": "EMODELREQUEST"
        }
      }
    }
  ]
